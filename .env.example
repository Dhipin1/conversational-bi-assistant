# ---- App ----
APP_TITLE=Conversational BI Assistant (Advanced)
DB_URL=sqlite:///./db/northwind.db
MAX_FIX_RETRIES=2

# ---- LLM Provider ----
# options: ollama | groq | openai
LLM_PROVIDER=groq

# ---- Groq (cloud, fast — recommended for public deployment) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ---- OpenAI (cloud fallback) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Ollama (local, free, private) ----
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434